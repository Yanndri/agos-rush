[sub_resource type="GDScript" id="GDScript_oxdc4"]
resource_name = "GameUIBackgroundBlur"
script/source = "extends Panel

@export var scoreboardpanel: MarginContainer


func _ready() -> void:
	if scoreboardpanel == null:
		push_warning(\"ScoreboardPanel is not assigned.\")
		return

	scoreboardpanel.visibility_changed.connect(_on_scoreboard_visibility_changed)
	_update_visibility()


func _on_scoreboard_visibility_changed() -> void:
	_update_visibility()


func _update_visibility() -> void:
	visible = scoreboardpanel.visible
"

